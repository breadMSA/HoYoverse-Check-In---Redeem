{
   "manifest_version": 3,
   "name": "HoYoverse Check-In & Redeem",
   "version": "1.0.0",
   "description": "Automatically checks in for all HoYoverse games and redeems codes.",
   "icons": {
      "16": "icons/main/icon96.png",
      "32": "icons/main/icon96.png",
      "48": "icons/main/icon96.png",
      "96": "icons/main/icon96.png"
   },
   "action": {
      "default_popup": "popup.html",
      "default_icon": {
         "16": "icons/main/icon96.png",
         "32": "icons/main/icon96.png",
         "48": "icons/main/icon96.png"
      }
   },
   "background": {
      "service_worker": "background.js"
   },
   "permissions": [
      "storage",
      "cookies",
      "alarms",
      "tabs",
      "webRequest"
   ],
   "host_permissions": [
      "*://*.hoyolab.com/*",
      "*://*.hoyoverse.com/*",
      "*://*.mihoyo.com/*",
      "*://*.ennead.cc/*"
   ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "author": "Bread",
   "key": ""
}
